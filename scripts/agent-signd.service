[Unit]
Description=agent-commits service (agent-commitsd, installed under its old name agent-signd): agent signing key and leases
After=network.target

[Service]
Type=simple
ExecStart=%h/.agent-sign/bin/agent-signd
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
