# Settings that are particular to one machine (read by lib.sh's load_env).
# This is the EXAMPLE: every value below is made up. Copy it to
# machine-<name>.env in this folder (git ignores that file; the real values
# for a real machine are never committed) and put the machine's real values in
# the copy. Nothing here is secret: addresses, public names and account names.
#
# The machine's first label in Tailscale (what `tailscale status` calls it).
TAILNET_NAME=hetzner
# OpenBao, which this machine reaches at its own tailnet address.
AUTH_ADDRESS=https://hetzner.example.ts.net:8200
AUTH_CA_CERT=/usr/local/share/openbao/ca.pem
AUTH_RESOLVE=100.64.0.10
# The SSH engine mount and role agentic-credentials' logins sitting makes, and
# the AppRole login (its name is the role ID, as agentic-credentials makes it).
AUTH_MOUNT=ssh-agents-hetzner
AUTH_ROLE=agent-sign-hetzner
LOGIN_NAME=agent-sign-hetzner
# The person agents' names are never allowed to equal ([identity] people).
IDENTITY_PEOPLE=Alex
