# The systemd user unit that keeps agent-commitsd running while you're logged
# in. scripts/install.sh installs and enables it; scripts/uninstall.sh removes it.
[Unit]
Description=agent-commits service: the agent signing key and leases
After=network.target

[Service]
Type=simple
ExecStart=%h/.agent-commits/bin/agent-commitsd
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
